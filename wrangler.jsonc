{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hazzi-report",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hazzi-reports",
      "database_id": "71eec451-8c8a-40db-a196-421ade611d96",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
